сти", "6000202611100003": "Об уменьшении минимального предельного срока владения объектом недвижимого имущества в целях освобождения от налогообложения налогом на доходы физических лиц до", "6000202611100004": "Об установлении на 2027 год коэффициента, отражающего региональные особенности рынка труда Псковской области", "6000202611100005": "О внесении изменений в Закон Псковской области «Об обеспечении жилыми помещениями детей-сирот и детей, оставшихся без попечения родителей, лиц из числа детей-си", "6000202611100006": "О внесении изменений в статьи 32 и 38 Закона Псковской области «О бюджетном процессе в Псковской области", "6000202611110001": "О внесении изменений в статью 4 Закона Псковской области «О дополнительных гарантиях по социальной поддержке детей-сирот и детей, оставшихся без попечения родит", "6000202611110002": "О внесении изменения в статью 7 Закона Псковской области «О порядке управления и распоряжения государственной собственностью Псковской области", "6000202611110003": "О внесении изменения в статью 9 Закона Псковской области «О регулировании отдельных вопросов в области охоты и сохранения охотничьих ресурсов в Псковской област", "6000202611110004": "О государственной поддержке студенческих отрядов в Псковской области", "6000202611110006": "О внесении изменений в Закон Псковской области «О противодействии коррупции в органах государственной власти Псковской области и органах местного самоуправления", "6000202611110007": "О внесении изменения в Закон Псковской области «О преобразовании муниципальных образований, входящих в состав Великолукского муниципального района Псковской обл", "6000202611110008": "О внесении изменения в Закон Псковской области «О преобразовании муниципальных образований, входящих в состав муниципального образования «Бежаницкий район»", "6000202611110009": "О внесении изменения в Закон Псковской области «О преобразовании муниципальных образований, входящих в состав Новосокольнического муниципального района Псковско", "6000202611110010": "О внесении изменения в Закон Псковской области «О преобразовании муниципальных образований, входящих в состав Дедовичского муниципального района Псковской облас"}, "unexplained": 0, "update": {"append": {"commits": 2, "corrections": null, "extended_acts": ["zakony-2026"], "new_acts": []}, "parts": ["95-watch-20261124-001.json"]}, "verify": {"cycle_days": 1, "examples": [], "held": 12, "method": "the portal's whole listing for the subject (read this check, every page) parsed by the builder (ru_catalogue.parse) and compared, publication day by publication day, with the corpus this repository is built from; each year's newest state rendered by the builder (gitlaw_common) against the files at the tip of main", "ok": true, "swept": 12, "versions_checked": 243, "versions_differ": 0}}
